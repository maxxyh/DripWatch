SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
DRIPWATCH_PASSCODE=replace-with-a-long-shared-passcode
DRIPWATCH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Development writes to hosted Supabase require deliberate opt-in. Keep this off for UI checks.
ALLOW_REMOTE_DEV_MUTATIONS=0
